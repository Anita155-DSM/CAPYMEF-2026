# ==========================================
# Variables de entorno del backend de CAPYMEF
# ==========================================
# Copiá este archivo como .env y completá los valores. NUNCA subas el .env real al repositorio.
# Al arrancar, config/verificarConfiguracion.js revisa estas variables: con NODE_ENV=production, si falta
# una obligatoria o hay una mal puesta, el servidor no arranca; en desarrollo solo muestra avisos.

# --- Entorno ---
# 'production' en el servidor real (activa el chequeo estricto). En desarrollo se deja vacío.
# Vitest la pone en 'test' sola (los tests usan una base en memoria).
NODE_ENV=

# --- Servidor ---
# Puerto del backend. Opcional: si falta, usa 3000.
PORT=

# --- Base de datos (PostgreSQL / Neon) ---
# Obligatorias en producción: DB_HOST, DB_USER, DB_PASSWORD, DB_DATABASE.
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_DATABASE=
# Opcional: si falta, usa 5432.
DB_PORT=
# 'true' si la base exige SSL (Neon lo exige). Opcional: si falta, conecta sin SSL.
DB_SSL=

# --- Sesiones ---
# Clave para firmar los tokens de sesión. Obligatoria en producción, de 32 caracteres o más.
JWT_SECRET=

# --- Direcciones públicas ---
# Dirección del frontend (links de los mails y vuelta del socio después de pagar).
# Obligatoria en producción y con https://. En desarrollo: http://localhost:5173
FRONTEND_URL=
# Dirección pública del backend (Mercado Pago le manda los avisos del webhook).
# Obligatoria en producción y con https://. En desarrollo, la dirección https de ngrok.
BACKEND_URL=

# --- Mercado Pago ---
# Access token de la aplicación de Mercado Pago. Obligatoria en producción.
MERCADOPAGO_ACCESS_TOKEN=
# Secreto con el que Mercado Pago firma los avisos del webhook (panel de Mercado Pago > Tu aplicación > Webhooks).
# Obligatoria en producción.
MP_WEBHOOK_SECRET=
# Verificación de la firma del webhook: off (no verifica), log (verifica y solo lo anota en la consola), enforce (rechaza los avisos sin firma válida).
# En producción tiene que ser 'enforce'.
MP_WEBHOOK_MODE=off
# Vuelta del socio después de pagar en Mercado Pago. En desarrollo local va en true: Mercado Pago no
# acepta localhost, así que vuelve por el backend (dirección pública) y este redirige al frontend.
# En producción va en false (o se borra): vuelve directo al frontend.
PAGO_RETORNO_VIA_BACKEND=false

# --- Mail (SMTP) ---
# SMTP_HOST, SMTP_USER y SMTP_PASS: obligatorias en producción. Sin ellas no se envían mails (recuperación
# de contraseña, comprobantes de pago). SMTP_PORT es opcional: si falta, usa 587.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Remitente de los mails. Opcional: si falta, usa "CAPYMEF" <no-responder@capymef.ar>.
EMAIL_FROM=

# --- Cloudinary (archivos subidos) ---
# Obligatorias en producción. Sin estas falla el registro de socios (la constancia se sube a Cloudinary) y
# no se pueden subir imágenes de noticias y eventos ni comprobantes.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Términos y condiciones del registro ---
# 'true': el registro de socios exige aceptaTerminos (que el socio aceptó los términos); si falta, responde 400
# y no se crea la cuenta. Sin esta variable (o en otro valor) rige el modo transitorio: la cuenta se crea igual,
# sin fecha ni versión de aceptación. En producción va en 'true' una vez que el frontend mande aceptaTerminos
# (mientras no esté, el servidor muestra un aviso al arrancar, sin impedirlo).
TERMINOS_OBLIGATORIOS=
